{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lorecanc/manage-agents/contract/opencode-pack.schema.json",
  "title": "OpenCode pack manifest (contract 1.x)",
  "description": "opencode-pack.json at the root of a pack. See contract/CONTRACT.md. `manage-agents pack validate` also checks the rules this schema cannot express (agent IDs, references, layout).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "name", "version", "description"],
  "properties": {
    "$schema": { "type": "string" },
    "contract": {
      "description": "Contract version as \"MAJOR.MINOR\". An unknown major is rejected; a newer minor only warns.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": {
      "description": "Global pack identity, used by `requires` and by the resolver.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "version": {
      "description": "Full semver version of the pack.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string", "minLength": 1 },
    "requires": {
      "description": "Packs this pack references, mapped to a semver range. \"*\" is accepted only in local sources.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "archetype": {
      "description": "Declares the pack as a routable archetype: the engine picks each subagent's model from the provider or model its caller runs on.",
      "type": "object",
      "additionalProperties": false,
      "required": ["callers", "reference"],
      "properties": {
        "callers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "routingDefaults": {
      "description": "Suggested routing: trigger (\"provider\" or \"provider/model\") -> subagent ID -> \"provider/model[#variant]\" or \"inherit\". The user's routing configuration overrides it.",
      "type": "object",
      "propertyNames": { "pattern": "^(?!\\$)[^\\s/#]+(?:/[^\\s#]+)?$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string", "pattern": "^(?:inherit|[^\\s/#]+/[^\\s#]+(?:#[^\\s#]+)?)$" }
      }
    },
    "flowDefaults": {
      "description": "Suggested conditional IF/OR rules (contract 1.1+): multi-trigger OR over provider/model/*, with subagent models, tool/MCP policies, permissions and delegation policies.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["triggers", "then"],
        "properties": {
          "callers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "triggers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:\\*|(?!\\$)[^\\s/#]+(?:/[^\\s#]+)?)$" } },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "models": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^(?:inherit|[^\\s/#]+/[^\\s#]+(?:#[^\\s#]+)?)$" } },
              "tools": { "type": "object", "additionalProperties": { "type": "string", "enum": ["allow", "ask", "deny"] } },
              "permissions": { "type": "object", "additionalProperties": { "type": "string", "enum": ["allow", "ask", "deny"] } },
              "delegations": { "type": "object", "additionalProperties": { "type": "string", "enum": ["allow", "deny"] } }
            }
          }
        }
      }
    }
  },
  "dependentRequired": { "routingDefaults": ["archetype"], "flowDefaults": ["archetype"] }
}
